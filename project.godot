; Engine configuration file.
config_version=5

[application]

config/name="Mt. Crankmore"
config/version="0.8.2"
config/description="Isometric pizza-delivery racing in a ski town, through all four seasons. Pedal a bicycle trainer to play."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3")

[autoload]

Controls="*res://scripts/controls.gd"
Season="*res://scripts/season.gd"
Game="*res://scripts/game.gd"
Trainer="*res://scripts/trainer_link.gd"
Talk="*res://scripts/trash_talk.gd"
Ride="*res://scripts/ride_log.gd"
Strava="*res://scripts/strava.gd"
Skies="*res://scripts/sky.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="fractional"

[gui]

theme/default_font_antialiasing=0
theme/default_font_hinting=2
theme/default_font_subpixel_positioning=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.45, 0.72, 0.97, 1)
